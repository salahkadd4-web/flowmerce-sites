// Flowmerce Sites — schéma Prisma
// Référence : flowmerce-sites.md §5. Phase 0 : comptes, sites et pages seulement ;
// les relations vers les autres modèles (abonnement, catalogue, commandes,
// domaines, outbox) seront ajoutées avec ces modèles.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────── Compte provisoire ─────────

// Compte provisoire (Phase 0) — remplacé par le SSO Flowmerce en Phase 3.
// Tenant.ownerUserId pointe vers User.id sans clé étrangère, pour que le SSO
// puisse fournir des identifiants externes sans migration de Tenant.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ───────── Compte vendeur ─────────

model Tenant {
  id                String   @id @default(cuid())
  name              String
  ownerUserId       String   @unique              // utilisateur du compte unique — un tenant par vendeur (§4.5)
  flowmerceSellerId String?  @unique              // vendeur côté Flowmerce
  flowmerceApiKey   String?                       // chiffrée
  sites             Site[]
  media             Media[]
  products          Product[]
  orders            Order[]
  customTemplates   CustomTemplate[]
  // Accord du vendeur : ses modèles de pages peuvent servir à entraîner le générateur
  // de modèles (IA). Faux par défaut ; daté quand il est donné, effacé quand il est retiré.
  aiTrainingConsent   Boolean   @default(false)
  aiTrainingConsentAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ───────── Sites et pages ─────────

model Site {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      SiteType                            // LANDING | STORE
  name      String
  subdomain String     @unique
  theme     Json                                // couleurs, police, logo
  locale    String     @default("fr")           // fr | ar — une langue par site en v1
  pixels    Json?                               // { facebook: "...", tiktok: "..." }
  status    SiteStatus @default(DRAFT)
  pages     Page[]
  orders    Order[]
  shipping  ShippingRate[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([tenantId])
}

model Page {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  slug      String                              // "" pour l'accueil
  title     String
  draft     Json                                // JSON Puck en cours d'édition
  published Json?                               // dernière version publiée
  seo       Json?
  versions  PageVersion[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, slug])
}

// Une ligne par publication (§5). Interface d'historique et de restauration en Phase 3.
model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  content     Json
  publishedAt DateTime @default(now())

  @@index([pageId, publishedAt])
}

// ───────── Médias ─────────

// Image envoyée par un vendeur. key = nom du fichier dans le stockage
// (32 hex + extension) ; url = chemin public (/media/<key> en local).
model Media {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String   @unique
  url       String
  mimeType  String
  width     Int
  height    Int
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ───────── Catalogue (§5) ─────────

// Produit du vendeur, utilisable sur tous ses sites (§2.4). Pas de relation
// Site.products : le produit d'une landing est choisi dans l'éditeur.
model Product {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String      @default("")
  price        Int                             // en DA
  comparePrice Int?                            // prix barré
  images       Json        @default("[]")      // [{ url, width, height }] — dimensions pour next/image
  optionAxes   Json        @default("[]")      // [{ name: "Taille", values: ["39", "40"] }], deux au plus
  sizeGuide    Json?                           // Phase 3
  active       Boolean     @default(true)
  variants     Variant[]
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tenantId])
}

// Une combinaison des axes du produit ({} sans axe), avec son stock.
model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  options    Json                              // { Taille: "39", Couleur: "noir" }
  stock      Int         @default(0)
  sku        String?
  orderItems OrderItem[]

  @@index([productId])
}

// Frais de livraison d'un site pour une wilaya (1 à 69). Sans ligne : non desservie.
model ShippingRate {
  id         String @id @default(cuid())
  siteId     String
  site       Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  wilayaCode Int
  home       Int                               // livraison à domicile, en DA
  office     Int?                              // livraison au bureau ; absent = non proposée

  @@unique([siteId, wilayaCode])
}

// ───────── Commandes (§5) ─────────

model Order {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  siteId         String
  site           Site               @relation(fields: [siteId], references: [id])
  idempotencyKey String             @unique    // évite les doublons (double clic, réessai)
  reference      String             @unique    // référence courte donnée à l'acheteur
  customerName   String
  phone          String                        // normalisé (+213…)
  wilayaCode     Int
  commune        String
  address        String
  deliveryType   DeliveryType                  // HOME | OFFICE
  items          OrderItem[]
  subtotal       Int
  shippingFee    Int
  total          Int
  status         OrderStatus        @default(NEW)
  events         OrderStatusEvent[]
  ip             String?
  userAgent      String?
  source         Json?                         // utm_source, utm_campaign…
  fraudScore     Float?                        // Phase 2 (Flowmerce)
  fraudAdvice    String?                       // Phase 2 (Flowmerce)
  flowmerceId    String?            @unique    // Phase 2 (Flowmerce)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([siteId, status, createdAt])
  @@index([tenantId, createdAt])
  @@index([phone])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String                           // copie au moment de la commande
  options     Json?                            // copie des options de la variante
  unitPrice   Int                              // copie du prix
  quantity    Int

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderStatusEvent {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from      OrderStatus?
  to        OrderStatus
  actor     String?                            // email du vendeur, "client" ou "flowmerce"
  note      String?
  createdAt DateTime     @default(now())

  @@index([orderId, createdAt])
}

// Compteur local de la limitation de débit (Redis / Upstash au déploiement).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// ───────── Énumérations ─────────

enum SiteType {
  LANDING
  STORE
}

enum SiteStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum DeliveryType {
  HOME
  OFFICE
}

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

// ───────── Modèles personnels ─────────

// Page enregistrée par le vendeur comme modèle, réutilisable dans l'éditeur et à la
// création d'un site. Contenu validé par les schémas des blocs (lib/custom-templates.ts).
model CustomTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  category  String   @default("Autre")
  data      Json
  createdAt DateTime @default(now())

  @@index([tenantId])
}
