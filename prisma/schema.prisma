// Flowmerce Sites — schéma Prisma
// Référence : flowmerce-sites.md §5. Phase 0 : comptes, sites et pages seulement ;
// les relations vers les autres modèles (abonnement, catalogue, commandes,
// domaines, outbox) seront ajoutées avec ces modèles.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────── Compte provisoire ─────────

// Compte provisoire (Phase 0) — remplacé par le SSO Flowmerce en Phase 3.
// Tenant.ownerUserId pointe vers User.id sans clé étrangère, pour que le SSO
// puisse fournir des identifiants externes sans migration de Tenant.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ───────── Compte vendeur ─────────

model Tenant {
  id                String   @id @default(cuid())
  name              String
  ownerUserId       String                        // utilisateur du compte unique
  flowmerceSellerId String?  @unique              // vendeur côté Flowmerce
  flowmerceApiKey   String?                       // chiffrée
  sites             Site[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ownerUserId])
}

// ───────── Sites et pages ─────────

model Site {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      SiteType                            // LANDING | STORE
  name      String
  subdomain String     @unique
  theme     Json                                // couleurs, police, logo
  locale    String     @default("fr")           // fr | ar — une langue par site en v1
  pixels    Json?                               // { facebook: "...", tiktok: "..." }
  status    SiteStatus @default(DRAFT)
  pages     Page[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([tenantId])
}

model Page {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  slug      String                              // "" pour l'accueil
  title     String
  draft     Json                                // JSON Puck en cours d'édition
  published Json?                               // dernière version publiée
  seo       Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, slug])
}

// ───────── Énumérations ─────────

enum SiteType {
  LANDING
  STORE
}

enum SiteStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}
